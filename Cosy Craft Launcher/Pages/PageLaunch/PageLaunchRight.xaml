<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <Grid>

        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
                <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,15"
                              Text="快照版 Cosy Craft Launcher 包含尚未正式发布的测试功能，仅限赞助者自己使用。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />
                <local:MyCard Margin="0,0,0,18" x:Name="PanWelcome" HasMouseAnimation="False">
                    <!-- 欢迎卡片单独使用更通透的玻璃面，露出手后的动态壁纸 -->
                    <local:MyCard.Resources>
                        <LinearGradientBrush x:Key="ColorBrushCardSurface" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8AFFFFFF" Offset="0" />
                            <GradientStop Color="#85FCFAFD" Offset="0.55" />
                            <GradientStop Color="#80FCF7F8" Offset="1" />
                        </LinearGradientBrush>
                    </local:MyCard.Resources>
                    <Grid Margin="2">
                        <local:ScarletBackdrop x:Name="ScarletHero" CornerRadius="12" Opacity="0.35" />

                        <!-- 除三个按钮外的主页欢迎内容已移除，用 MinHeight 保留原有卡片空白体积。 -->
                        <Grid Margin="26,26,26,18" MinHeight="266">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="欢迎使用 Cosy Craft Launcher！" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <TextBlock.Foreground>
                                        <!-- 蕾米莉亚的月色紫红过渡到芙兰朵露的彩虹金，与主题色板呼应。 -->
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#77609D" Offset="0" />
                                            <GradientStop Color="#C4637D" Offset="0.55" />
                                            <GradientStop Color="#D9A24E" Offset="1" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Text="MVPClub出品 基于PCL，各项功能正常版本！" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{StaticResource ColorBrushTextSecondary}" />
                                <local:MyTextButton x:Name="BtnWelcomeRepo" Margin="0,8,0,0" FontSize="13"
                                                    Text="项目地址：https://github.com/MVPS680/Cosy-Craft-Launcher" />
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Bottom">
                                <local:MyButton x:Name="BtnWelcomeDownload" Text="下载游戏" Height="38" MinWidth="116" Padding="18,0" Margin="0,0,10,10" ColorType="Highlight" />
                                <local:MyButton x:Name="BtnWelcomePack" Text="安装整合包" Height="38" MinWidth="116" Padding="18,0" Margin="0,0,10,10" />
                                <local:MyButton x:Name="BtnWelcomeSetup" Text="打开设置" Height="38" MinWidth="104" Padding="18,0" Margin="0,0,0,10" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </local:MyCard>
                <local:MyCard x:Name="PanWelcomeGuide" Title="旅程，从这里开始" Margin="0,0,0,18" HasMouseAnimation="False" Visibility="{Binding Visibility, ElementName=PanWelcome}">
                    <WrapPanel Margin="20,42,10,12">
                        <Border Width="124" Padding="8,12" Margin="0,0,10,10" CornerRadius="8" Background="Transparent">
                            <StackPanel>
                                <TextBlock Text="01  /  选择版本" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" />
                                <TextBlock Text="原版或整合包，找到喜欢的玩法。" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource ColorBrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border Width="124" Padding="8,12" Margin="0,0,10,10" CornerRadius="8" Background="Transparent">
                            <StackPanel>
                                <TextBlock Text="02  /  配置账号" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" />
                                <TextBlock Text="在左侧选择需要使用的账号。" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource ColorBrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border Width="124" Padding="8,12" Margin="0,0,10,10" CornerRadius="8" Background="Transparent">
                            <StackPanel>
                                <TextBlock Text="03  /  开始冒险" FontWeight="SemiBold" Foreground="{StaticResource ColorBrushGold}" />
                                <TextBlock Text="确认版本，点击左侧启动游戏。" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource ColorBrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </local:MyCard>
                <StackPanel x:Name="PanCustom">
                </StackPanel>
                <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                    <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                             AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
